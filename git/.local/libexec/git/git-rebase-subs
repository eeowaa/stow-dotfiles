#!/usr/bin/env bash
# XXX: This entire script was generated by Claude Code (Opus 5.5).
# git-rebase-subs: rebase the current superproject branch onto its upstream, remapping every
# submodule gitlink from the pre-rebase submodule commits to their rebased equivalents.
#
# usage: git rebase-subs [upstream]
#
# Prerequisite: for every submodule that BOTH this branch and upstream changed, fetch it, rebase
# its feature branch onto the commit upstream's gitlink points at, and leave it checked out.
# The script checks this before rewriting anything.
#
# upstream defaults to <remote>/HEAD (remote = current branch's remote, else origin), then the
# remote's advertised HEAD (git ls-remote), then init.defaultBranch (else master).
#
# Old->new submodule commits are matched by author time + author email + subject, which rebase
# preserves. Reworded, squashed or dropped submodule commits are not mapped; check the result
# with `git log -p <upstream>..HEAD -- <submodule>`.
set -euo pipefail
self=$(realpath "$0")
cd "$(git rev-parse --show-toplevel)"

# --- Internal: invoked by `git rebase --exec` after each picked commit ---------------------------
if [ "${1:-}" = "--fix" ]; then
  map=$2
  git ls-files -s | while IFS=$' \t' read -r mode sha _ path; do
    if [ "$mode" = 160000 ]; then
      new=$(awk -v o="$sha" '$1==o {print $2; exit}' "$map")
      if [ -n "$new" ] && [ "$new" != "$sha" ]; then
        git update-index --cacheinfo "160000,$new,$path"
      fi
    fi
  done
  git diff --cached --quiet || git commit --amend --no-edit --no-verify --quiet
  exit 0
fi

case "${1:-}" in
  -h|--help) sed -n '2,17p' "$self" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

resolve_upstream() {
  local remote ref name
  remote=$(git config "branch.$(git branch --show-current).remote" 2>/dev/null) || true
  [ -n "$remote" ] && [ "$remote" != . ] || remote=origin

  # 1. Locally recorded remote HEAD (set by clone, or by fetch with followRemoteHEAD)
  if ref=$(git symbolic-ref -q --short "refs/remotes/$remote/HEAD"); then
    echo "$ref"; return
  fi
  # 2. Ask the remote what its HEAD points at
  name=$(git ls-remote --symref "$remote" HEAD 2>/dev/null \
         | awk '$1=="ref:" && $3=="HEAD" {sub("^refs/heads/","",$2); print $2}') || true
  if [ -n "$name" ]; then
    echo "$remote/$name"; return
  fi
  # 3. init.defaultBranch, else Git's built-in default
  name=$(git config init.defaultBranch) || name=master
  if git rev-parse -q --verify "refs/remotes/$remote/$name" >/dev/null; then
    echo "$remote/$name"
  else
    echo "$name"
  fi
}

if [ -d "$(git rev-parse --git-path rebase-merge)" ] || [ -d "$(git rev-parse --git-path rebase-apply)" ]; then
  echo "A rebase is already in progress; finish or abort it first." >&2
  exit 1
fi

upstream=${1:-$(resolve_upstream)}
if ! git rev-parse -q --verify "$upstream^{commit}" >/dev/null; then
  echo "Upstream '$upstream' doesn't resolve to a commit (need 'git fetch'?)" >&2
  exit 1
fi
echo "Rebasing onto $upstream"

fork=$(git merge-base HEAD "$upstream")
map="$(git rev-parse --absolute-git-dir)/submodule-rebase-map"
: > "$map"
key() { git -C "$1" log --format='%at|%ae|%s%x09%H' "${@:2}" | LC_ALL=C sort; }

# Every gitlink path this branch changed
mapfile -t subs < <(git log --format= --raw --no-abbrev "$fork..HEAD" \
  | awk -F'\t' '{split($1,a," "); if (a[1]==":160000" || a[2]=="160000") print $2}' | sort -u)

bad=
for sub in "${subs[@]}"; do
  old_base=$(git rev-parse -q --verify "$fork:$sub") || continue      # added on this branch
  new_base=$(git rev-parse -q --verify "$upstream:$sub") || continue  # removed upstream
  [ "$old_base" != "$new_base" ] || continue                          # upstream didn't move it
  new_tip=$(git -C "$sub" rev-parse HEAD)
  if ! git -C "$sub" merge-base --is-ancestor "$new_base" "$new_tip" 2>/dev/null; then
    echo "$sub: HEAD isn't based on ${new_base:0:12} (fetch + rebase it first)" >&2
    bad=1; continue
  fi
  mapfile -t old_tips < <(git log --format= --raw --no-abbrev "$fork..HEAD" -- "$sub" \
    | awk '$4 !~ /^0+$/ {print $4}' | sort -u)
  before=$(wc -l < "$map")
  LC_ALL=C join -t $'\t' <(key "$sub" "${old_tips[@]}" "^$old_base") \
                         <(key "$sub" "$new_base..$new_tip") \
    | cut -f2,3 | tr '\t' ' ' >> "$map"
  echo "$sub: mapped $(( $(wc -l < "$map") - before )) commit(s)"
done
[ -z "$bad" ] || exit 1

git rebase -x "\"$self\" --fix \"$map\"" "$upstream" || true
while [ -d "$(git rev-parse --git-path rebase-merge)" ]; do
  unmerged=$(git ls-files -u)
  if [ -z "$unmerged" ] || awk '$1!=160000 {f=1} END {exit !f}' <<<"$unmerged"; then
    echo "Stopped on a non-submodule conflict or failed exec. Resolve, then 'git rebase --continue'." >&2
    echo "(For gitlink conflicts, take REBASE_HEAD's value; the exec step remaps it.)" >&2
    exit 1
  fi
  awk -F'\t' '{split($1,a," "); if (a[3]==3) print a[2], $2}' <<<"$unmerged" \
    | while read -r sha path; do git update-index --cacheinfo "160000,$sha,$path"; done
  if [ -n "$(git ls-files -u)" ]; then
    echo "A gitlink conflict has no stage-3 side (submodule deleted?); resolve by hand." >&2
    exit 1
  fi
  GIT_EDITOR=true git rebase --continue || true
done
echo "Done. Delete $map, run 'git submodule update --recursive', review with 'git range-diff'."
