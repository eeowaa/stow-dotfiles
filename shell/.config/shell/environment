if [ "$DEBUG" ]; then
    if [ "$BASH_VERSION" ]; then
        echo "Sourcing: $BASH_SOURCE"
    elif [ "$ZSH_VERSION" ]; then
        echo "Sourcing: ${(%):-%N}"
    else
        echo "Sourcing: shell environment"
    fi >&2
fi

###############################################################################
# Shell and terminal settings must be explicitly defined in each interactive
# shell and tmux pane (pty device). For performance reasons on slow systems,
# ~/.bashrc should duplicate these settings rather than sourcing them:

# Use Emacs-style line editing
set +o vi
set -o emacs

# Terminal settings
stty -ixon

###############################################################################

# Cut startup time for non-login shells by exporting functions when possible.
# If a shell can export functions, but not aliases, define aliases as functions.
_exportf() {
    if [ "$BASH_VERSION" ]; then
        export -f "$1"
    fi
}
_alias() {
    if [ "$BASH_VERSION" ]; then
        local args=$(
            printf '%s' "$2" |
            sed -e "s#\\([;(| 	]\\)$1\\>#\\1command $1#g" \
                -e "s#^$1#command $1#"
        )
        eval "function $1 { $args \"\$@\"; }"
        export -f "$1"
    else
        alias "$1=$2"
    fi
}

# Aliases for interactive use
_alias p 'pwd'
_alias j 'jobs'
_alias e 'echo $?'
_alias grep 'grep --color=auto'
_alias ls 'ls --color=auto --group-directories-first -v'
_alias ll 'command ls --color=auto --group-directories-first -vl'

# Functions for interactive use
f() {
    cd ${1+"$@"} && ls
}; _exportf f

g() {
    # URL-encoded query string
    local query='q='`echo "$*" | sed 's/ /%20/g'`

    # DuckDuckGo-specific query parameters
    # See <https://duckduckgo.com/params>
    query="$query&kl=us-en"        # Region = US English
    query="$query&k1=-1"           # Advertisements = OFF
    query="$query&kam=google-maps" # Directions source = Google Maps

    # Perform the query
    $BROWSER "https://duckduckgo.com?$query"
}; _exportf g

up() {
    [ $# -eq 0 ] && {
        cd ..
        return
    }
    expr "X$1" : 'X[0-9]\{1,\}$' >/dev/null 2>&1 || return 1
    local count=$1 startdir=`pwd`
    while [ $count -gt 0 ]; do
        cd .. || break
        count=`expr $count - 1`
    done
    OLDPWD=$startdir
}; _exportf up

goto() {
    local target=`readlink -f "$1"`
    [ -d "$target" ] || target=${target%/*}
    [ -d "$target" ] && cd "$target"
    pwd
}; _exportf goto

cdsed() {
    local dest=`pwd | sed "s|$1|$2|"`
    cd "$dest"
    pwd
}; _exportf cdsed

fixpath() {
    # Remove duplicate and nonexistent entries from `PATH'
    PATH=`echo "$PATH" | tr : '\n' | awk '
    NF {
        if ($0 in y) {
            print "Removing duplicate PATH entry:", $0 > "/dev/stderr"
        } else if (system(sprintf("/bin/sh -c \"test -d '\''%s'\''\"", $0)) != 0) {
            print "Removing nonexistent PATH entry:", $0 > "/dev/stderr"
        } else {
            y[$0] = 1
            x[++n] = $0
        }
    }
    END {
        for (i = 1; i <= n - 1; ++i)
            printf x[i] ":"
        print x[n]
    }'`
    export PATH
}; _exportf fixpath

editpath() {
    local tmpfile=`mktemp`
    echo "$PATH" | tr : '\n' >"$tmpfile"
    ${VISUAL:-$EDITOR} "$tmpfile" && {
        PATH=`tr '\n' : <"$tmpfile"`
        fixpath
    }
    rm -f "$tmpfile"
}; _exportf editpath

# Source each environment script
for environ in "$HOME/.environ.d"/*.sh
do
    if [ "$DEBUG" ]; then
        echo >&2 "Sourcing: $environ"
    fi
    . "$environ"
done

# Shells with function export capability only need to define functions once
# within a process tree (functions are stored in environment variables)
if [ "$BASH_VERSION" ]; then
    export __ENVIRON_SOURCED=1
fi
