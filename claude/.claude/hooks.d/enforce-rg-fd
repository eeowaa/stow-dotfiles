#!/usr/bin/jq -f
# On WSL 1 '/usr/bin/env -S jq -f' incurs 100-150 ms of additional overhead.
# This hook runs often enough that hard-coding the path to 'jq' is worth it.
  .tool_input.command // "" as $bash
| . = ""
| if $bash | test("(^|[\\s;&|])grep(\\s|$)")
  then . += "Blocked: use \"rg\" (ripgrep) instead of \"grep\".\n"
  end
| if $bash | test("(^|[\\s;&|])find(\\s|$)")
  then . += "Blocked: use \"fd\" (fd-find) instead of \"find\".\n"
  end
| if . == ""
  then halt
  else (. + "Rewrite the command using equivalent flags and retry.\n") | halt_error(2)
  end
